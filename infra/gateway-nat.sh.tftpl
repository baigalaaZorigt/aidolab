#!/bin/bash
# Turns the gateway into the NAT instance for the private subnets (runs on first boot).
set -euxo pipefail

cat > /etc/sysctl.d/90-aidolab-nat.conf <<CONF
net.ipv4.ip_forward = 1
CONF
sysctl --system

cat > /usr/local/sbin/aidolab-nat.sh <<'SCRIPT'
#!/bin/bash
set -euo pipefail
IFACE=$(ip route show default | awk '{print $5; exit}')
iptables -t nat -C POSTROUTING -s ${vpc_cidr} -o "$IFACE" -j MASQUERADE 2>/dev/null \
  || iptables -t nat -A POSTROUTING -s ${vpc_cidr} -o "$IFACE" -j MASQUERADE
# Student apps may pass through the gateway to the internet, but must not reach the gateway itself
# (SSH, dashboard). Replies to the proxy's own connections are still allowed.
iptables -C INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null \
  || iptables -I INPUT 1 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
%{ for cidr in private_cidrs ~}
iptables -C INPUT -s ${cidr} -j DROP 2>/dev/null || iptables -A INPUT -s ${cidr} -j DROP
%{ endfor ~}
SCRIPT
chmod 755 /usr/local/sbin/aidolab-nat.sh

cat > /etc/systemd/system/aidolab-nat.service <<'UNIT'
[Unit]
Description=aidolab NAT and host firewall rules
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/aidolab-nat.sh
RemainAfterExit=true

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now aidolab-nat.service
