[Unit]
Description=aidolab dashboard (gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=aidolab
Group=aidolab
WorkingDirectory=/srv/aidolab/app
EnvironmentFile=/etc/aidolab/env
# Scans can take a minute (clone + OSV + bandit + AI advice).
ExecStart=/srv/aidolab/venv/bin/gunicorn config.wsgi --bind 127.0.0.1:8000 --workers 2 --timeout 180
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
